# Application
DEBUG=true
APP_NAME=ParkSmart API

# Local PostgreSQL (docker-compose)
DATABASE_URL=postgresql+pg8000://parksmart:parksmart@db:5432/parksmart

# Google Cloud SQL (production — set via Secret Manager / Cloud Run env)
# CLOUD_SQL_CONNECTION_NAME=project-id:region:instance-name
# DB_USER=parksmart
# DB_PASSWORD=
# DB_NAME=parksmart

# Auth - CHANGE IN PRODUCTION
JWT_SECRET_KEY=dev-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
